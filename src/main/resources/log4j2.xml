<?xml version="1.0" encoding="UTF-8" ?>
<Configuration monitorInterval="30">
    <!-- LOCAL -->
    <Properties>
        <Property name="log-path">./log/</Property>
        <Property name="pattern">%d{yyyy.MM.dd HH:mm:ss.SSS} [%t] %p %F:%L: %m%n</Property>
        <Property name="roll-name-pattern">%d{yyyy-MM-dd}-%02i</Property>
        <Property name="log-file">first</Property>
    </Properties>

    <Appenders>
        <RollingRandomAccessFile name="First"	append="true" fileName="${log-path}/${log-file}.log" filePattern="${log-path}/${log-file} - ${roll-name-pattern}.log.gz">
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
            <PatternLayout pattern="${pattern}" />
        </RollingRandomAccessFile>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="org.mik.first" additivity="false" level="DEBUG">
            <appender-ref ref="First" />
            <appender-ref ref="Console" />
        </Logger>

        <Root level="INFO">
            <appender-ref ref="First" level="INFO"/>
            <appender-ref ref="Console" level="INFO"/>
        </Root>
    </Loggers>
</Configuration>
